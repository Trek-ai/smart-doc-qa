# 复制为 .env.local 后填入自己的密钥；.env.local 不会进版本库。

# ---- 生成模型（必填，也是唯一必配项）----
# 任何 OpenAI 兼容接口都可以：DeepSeek 官方、阿里云 MaaS、硅基流动等。
# 注意 DEEPSEEK_MODEL 要填「接口里的模型 id」（通常是小写英文），不是控制台界面上的显示名。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 可选 ----
# 推理模型默认保留思考（答案更稳、首字更慢）；想更快就设成 off。
LLM_CHAT_THINKING=on
# 索引落盘目录，默认 source/.data
# DATA_DIR=