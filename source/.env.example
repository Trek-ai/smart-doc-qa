# 环境变量模板。仓库已内置一份可直接用的 source/.env（免密钥免费模型），通常无需改动。

# ---- 生成通道 ----
# free     = 免费免密钥模型（默认，零成本；有约 30 秒/次的频率限制）
# deepseek = 使用自己的密钥（更快更稳，按量计费）
LLM_PROVIDER=free

# ---- 免费通道（无需密钥）----
FREE_BASE_URL=https://text.pollinations.ai/openai
FREE_MODEL=openai

# ---- DeepSeek 通道（切到 deepseek 时才需要填）----
# 任何 OpenAI 兼容接口都可以；DEEPSEEK_MODEL 已在代码中锁定为 chat 模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 可选 ----
# 索引落盘目录，默认 source/.data
# DATA_DIR=
